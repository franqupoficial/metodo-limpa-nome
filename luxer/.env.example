# ───────── Banco de dados (PostgreSQL: Supabase, Neon ou próprio) ─────────
DATABASE_URL="postgresql://usuario:senha@host:5432/luxer?schema=public"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/luxer?schema=public"

# URL pública da loja (sem barra final)
APP_URL="https://www.luxerjoias.com.br"

# Criptografia de dados pessoais (CPF, endereços). Gere cada uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""
HASH_KEY=""
# Segredo para a rotina agendada (/api/jobs/run). Na Vercel, use também CRON_SECRET com o mesmo valor.
CRON_SECRET=""

# Proprietário inicial (senha NUNCA no código: use `npm run admin:create-owner` ou "Esqueci minha senha")
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_INITIAL_PASSWORD=""

# ───────── Armazenamento de imagens ─────────
# local (disco) ou s3 (Supabase Storage S3, Cloudflare R2, AWS S3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/media"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL pública/CDN do bucket (opcional). Sem ela, as imagens são servidas por /media/...
NEXT_PUBLIC_MEDIA_URL=""

# ───────── Pagar.me (API v5) ─────────
PAGARME_SECRET_KEY=""
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=""
PAGARME_WEBHOOK_USER=""
PAGARME_WEBHOOK_PASSWORD=""

# ───────── Melhor Envio (Correios e transportadoras) ─────────
MELHORENVIO_TOKEN=""
MELHORENVIO_ENV="sandbox"
MELHORENVIO_CONTACT_EMAIL=""

# ───────── E-mail transacional (SMTP: Resend, SES, Brevo, Google Workspace…) ─────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Luxer Joias <nao-responda@luxerjoias.com.br>"

# ───────── Concierge Luxer (atendimento com IA — Claude) ─────────
ANTHROPIC_API_KEY=""

# ───────── Luxer AI (provador virtual) ─────────
