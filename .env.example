# Banco de dados PostgreSQL
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_consumidor?schema=public"
# Conexão direta para migrações (igual à DATABASE_URL quando não há pooler)
DATABASE_URL_UNPOOLED="postgresql://portal:portal@localhost:5432/portal_consumidor?schema=public"

# URL pública do site (sem barra final)
APP_URL="http://localhost:3000"
# Produção: APP_URL="https://portalconsumidor.ong.br"

# Chaves de criptografia (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DATA_ENCRYPTION_KEY=""
HASH_KEY=""

# Administrador inicial (a senha NUNCA fica no código: defina com `npm run admin:set-password`
# ou pelo fluxo "Esqueci minha senha" em /admin/recuperar-senha)
ADMIN_EMAIL="kennedysantosof@gmail.com"
# Opcional: senha inicial aplicada no primeiro deploy (somente se o admin ainda não tiver senha). Remova depois.
ADMIN_INITIAL_PASSWORD=""

# SMTP para e-mails (recuperação de senha, confirmações). Sem SMTP, os e-mails são registrados no console do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Portal Consumidor <nao-responda@exemplo.com.br>"
